# Server binding
HOST=127.0.0.1
PORT=8000

# API authentication (automatically generated when binding to 0.0.0.0 if unset)
# KOMAWEAVE_API_KEY=change-me-to-a-strong-random-token

# Comma-separated CORS origins (use * for all origins)
ALLOWED_ORIGINS=*

# Set to 1 only if you want custom provider URLs to allow localhost/127.0.0.1 (e.g. Ollama)
KOMAWEAVE_ALLOW_LOCAL_PROVIDERS=0

# Upload, pixel & concurrency safety limits
MAX_UPLOAD_MB=25
MAX_BATCH_FILES=300
MAX_BATCH_TOTAL_MB=250
MAX_IMAGE_WIDTH=8192
MAX_IMAGE_HEIGHT=16384
MAX_IMAGE_PIXELS=40000000
MAX_CONCURRENT_GPU_JOBS=2
REQUEST_TIMEOUT_SECONDS=300
RATE_LIMIT_PER_MINUTE=60
TRANSLATE_RATE_LIMIT_PER_MINUTE=30
MODEL_DISCOVERY_RATE_LIMIT_PER_MINUTE=20

# Model preloading at server startup: all | ocr | none (lazy-loads on demand)
PRELOAD_MODELS=all

# OCR & Inpainting tuning
OCR_DET_LIMIT_SIDE=1088
OCR_DET_BOX_THRESH=0.28
OCR_DET_THRESH=0.20
OCR_DET_UNCLIP_RATIO=1.6
AOT_MAX_SIDE=1024
